{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and learning progress",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "Role" },
        "selectedLevel": { "type": "string", "enum": ["beginner", "intermediate", "advanced"], "description": "Chosen difficulty level" },
        "onboardingCompleted": { "type": "boolean", "description": "Whether first-time onboarding modal was finished" },
        "points": { "type": "number", "description": "Total earned points (+1 per first-attempt correct quiz answer)" },
        "currentCourse": { "type": "string", "description": "Active course ID" },
        "currentLessonId": { "type": "string", "description": "Last visited lesson ID" },
        "completedLessons": { "type": "array", "description": "List of completed lesson IDs" },
        "completedExercises": { "type": "array", "description": "List of completed exercise IDs" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" },
        "lastActivityDate": { "type": "string", "description": "Last activity timestamp" }
      },
      "required": ["uid", "email"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Record of a user's quiz question attempt",
      "type": "object",
      "properties": {
        "questionId": { "type": "string", "description": "Question ID" },
        "firstAttemptCorrect": { "type": "boolean", "description": "Whether correct on first attempt" },
        "attemptsCount": { "type": "number", "description": "Total attempts on this question" },
        "earnedPoint": { "type": "boolean", "description": "Whether point was rewarded" },
        "answeredAt": { "type": "string", "description": "Timestamp" }
      },
      "required": ["questionId", "firstAttemptCorrect", "attemptsCount"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Community user comment and platform review rating",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Comment ID" },
        "userId": { "type": "string", "description": "Author UID" },
        "userDisplayName": { "type": "string", "description": "Author display name" },
        "userPhotoURL": { "type": "string", "description": "Author photo" },
        "content": { "type": "string", "description": "Comment body" },
        "rating": { "type": "number", "description": "1 to 5 star rating" },
        "reported": { "type": "boolean", "description": "Flag for moderation" },
        "createdAt": { "type": "string", "description": "Timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["userId", "content", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Log of administrative moderation actions",
      "type": "object",
      "properties": {
        "adminEmail": { "type": "string", "description": "Admin email" },
        "action": { "type": "string", "description": "Moderation action taken" },
        "targetId": { "type": "string", "description": "Affected entity ID" },
        "timestamp": { "type": "string", "description": "Action timestamp" }
      },
      "required": ["adminEmail", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile and learning progress state"
    },
    "/users/{userId}/quizAttempts/{questionId}": {
      "schema": "QuizAttempt",
      "description": "Individual quiz question attempt records for points validation"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Community reviews, feedback, and ratings"
    },
    "/admin_audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Secure logs of moderation actions"
    }
  }
}
